# Copy to .env locally — NEVER commit real secrets
# Frontend (already used by Vite)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Local smokes (smoke:rls, smoke:paystack, …) — never commit real values
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
# Supabase CLI deploy (Account → Access Tokens) — NOT service_role JWT
SUPABASE_ACCESS_TOKEN=

# Optional research (scripts/research-tavily.mjs)
TAVILY_API_KEY=

# Optional Partna spike (partna-quote Edge; Stellar NOT on Partna networks — see memory/PARTNA.md)
PARTNA_API_KEY=
PARTNA_API_USER=

# Optional Daraja (Safaricom) sandbox
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_ENV=sandbox
DARAJA_INITIATOR_NAME=testapi
DARAJA_SHORTCODE=600986
# From portal Test Credentials (required for B2C)
DARAJA_SECURITY_CREDENTIAL=

# Optional MTN MoMo — Collections key OK for apiuser; Disbursements key needed for payouts
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_DISBURSEMENT_SUBSCRIPTION_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
MTN_MOMO_TARGET_ENV=sandbox

# Optional Soroban policy contract ID after deploy (contracts/spending-policy/)
STELLAR_SOROBAN_POLICY_CONTRACT_ID=
# Legacy simulate-only check_spend (default: submit try_spend on-chain)
STELLAR_SOROBAN_SIMULATE_ONLY=
# Optional Soroban RPC (default: soroban-testnet.stellar.org)
STELLAR_SOROBAN_RPC_URL=
# Emergency only: allow /pay if Soroban RPC fails (default fail-closed when contract set)
STELLAR_SOROBAN_SOFT_FAIL=

# Edge function secrets (also set in Supabase Dashboard → Edge Functions → Secrets)
PAYSTACK_SECRET_KEY=
PAYSTACK_DEFAULT_BANK_CODE=058
PAYSTACK_MOMO_PROVIDER=mtn

FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_DEFAULT_BANK_CODE=044

STELLAR_NETWORK=testnet
STELLAR_TREASURY_SECRET=
STELLAR_TREASURY_PUBLIC=
# Optional override — defaults to Circle testnet USDC issuer in code
STELLAR_USDC_ISSUER=
STELLAR_USDC_CODE=USDC
STELLAR_HORIZON_URL=

WEBHOOK_INTERNAL_SECRET=

# Waitlist confirmation emails (Resend)
RESEND_API_KEY=
RESEND_FROM=Paysmith <paysmith@tryopal.asia>
PAYSMITH_SITE_URL=https://paysmith-eight.vercel.app
